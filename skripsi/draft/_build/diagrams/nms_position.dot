digraph nms_position {
  rankdir=LR;
  fontname="Arial";
  node [shape=box, style="rounded,filled", fillcolor=white, color="#2c3e50", fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#2c3e50"];

  subgraph cluster_baseline {
    label="Baseline — NMS bawaan nvinfer";
    fontname="Arial"; fontsize=11; style=rounded; color="#7f8c8d";
    A1 [label="Backbone + Head YOLO"];
    A2 [label="Raw output per anchor/box\n(belum difilter)"];
    A3 [label="NMS sekuensial\n(post-processing CPU,\ndi luar TensorRT engine)", fillcolor="#f8d7da", color="#c0392b"];
    A4 [label="Box hasil akhir"];
    A1->A2->A3->A4;
  }
  subgraph cluster_optimized {
    label="Optimized — EfficientNMS_TRT";
    fontname="Arial"; fontsize=11; style=rounded; color="#7f8c8d";
    B1 [label="Backbone + Head YOLO"];
    B2 [label="Raw output per anchor/box\n(belum difilter)"];
    B3 [label="EfficientNMS_TRT\n(tail node, satu graph TensorRT,\nkernel paralel GPU)", fillcolor="#d4edda", color="#27ae60"];
    B4 [label="Box hasil akhir"];
    B1->B2->B3->B4;
  }
  A5 [label="nvtracker"];
  B5 [label="nvtracker"];
  A4->A5;
  B4->B5;
}

digraph measurement_structure {
  rankdir=TB;
  fontname="Arial";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#2c3e50", fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#2c3e50"];

  D   [label="Desain eksperimen\n6 konfigurasi model × 2 tracker × 5 repetisi\n= 60 run runtime"];
  ACC [label="Evaluasi akurasi KITTI\n(mAP, precision, recall)\nterpisah dari 60 run runtime, §3.5.1", fillcolor="#fdf6e3"];
  FPS [label="Throughput\n(FPS)"];
  LAT [label="Latensi end-to-end\n+ dekomposisi 7 tahap pipeline"];
  RES [label="Utilisasi GPU/CPU/RAM\n+ daya sistem (VDD)"];
  S32 [label="§3.2 — RM1\nPipeline baseline real-time?", fillcolor="#eafaf1"];
  S33 [label="§3.3 — RM2\nEfek EfficientNMS", fillcolor="#eafaf1"];
  S34 [label="§3.4 — RM3\nNvDCF vs. NvSORT", fillcolor="#eafaf1"];
  S36 [label="§3.6 — Trade-off & Pareto\nakurasi vs. efisiensi", fillcolor="#eafaf1"];

  D->FPS; D->LAT; D->RES;
  FPS->S32; LAT->S32;
  FPS->S33; LAT->S33;
  FPS->S34; LAT->S34; RES->S34;
  FPS->S36; RES->S36; ACC->S36;
}

digraph nms_buildtime_runtime {
  rankdir=TB;
  fontname="Arial";
  node [shape=box, style="rounded,filled", fillcolor=white, color="#2c3e50", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#2c3e50"];

  subgraph cluster_bt {
    label="Build-time — sekali, offline (utilitas pembangun engine)";
    fontname="Arial"; fontsize=11; style=rounded; color="#7f8c8d";
    O1 [label="Model ONNX\nbackbone + head, TIDAK diubah", shape=oval];
    O2 [label="2. Temukan tensor internal pre-NMS\n[1, 8400, 7] = x1,y1,x2,y2,\nscore_class0..2\n(sebelum output baseline [1,8400,6])"];
    O3 [label="4. Pasang node EfficientNMS_TRT\npada definisi jaringan TensorRT,\ndisambung langsung ke tensor internal itu", fillcolor="#fff3cd", color="#b8860b"];
    O4 [label="Engine EfficientNMS\nengine BARU & terpisah — ONNX\ndan engine baseline tetap utuh", shape=oval, fillcolor="#d4edda", color="#27ae60"];
    O1->O2 [label="1. parse graph ONNX"];
    O2->O3 [label="3. tambahkan node plugin"];
    O3->O4 [label="5. bangun jaringan terserialisasi"];
  }
  subgraph cluster_rt {
    label="Runtime — per frame, di dalam nvinfer";
    fontname="Arial"; fontsize=11; style=rounded; color="#7f8c8d";
    R1 [label="Backbone + Head YOLO"];
    R2 [label="EfficientNMS_TRT\nnode plugin, kernel GPU", fillcolor="#d4edda", color="#27ae60"];
    R3 [label="4 output plugin standar:\nnum_detections, detection_boxes,\ndetection_scores, detection_classes"];
    R1->R2 [label="tensor internal\n(sudah menyatu)"];
    R2->R3;
  }
  O4->R1 [style=dashed, label="di-load nvinfer sbg satu engine"];
}

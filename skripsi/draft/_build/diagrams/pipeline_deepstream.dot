digraph pipeline {
  rankdir=TB;
  fontname="Arial";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#2c3e50", fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#2c3e50"];

  A [label="Kamera ZED / File Video"];
  B [label="nvstreammux\n(multiplexing NVMM)"];
  C [label="nvinfer\n(Primary GIE / model YOLO)"];
  D [label="nvtracker\n(profil tracker terpilih)"];
  E [label="nvvideoconvert"];
  F [label="nvdsosd\n(gambar bbox + label + FPS)"];
  G [label="Output Sink", shape=diamond, fillcolor="#fdf6e3"];
  H [label="RTSP Stream"];
  I [label="Monitor lokal\n(nv3dsink)"];
  J [label="File MP4"];
  K [label="Thread Pencatat Benchmark\n(antrean asinkron)", fillcolor="#eafaf1"];
  L [label="Log metrik performa per frame", shape=note, fillcolor="white"];
  P [label="Thread Pencatat Deteksi\n(antrean asinkron)", fillcolor="#eafaf1"];
  Q [label="Log deteksi mentah per model", shape=note, fillcolor="white"];
  M [label="tegrastats", fillcolor="#eafaf1"];
  N [label="Parser Log (C++)", fillcolor="#eafaf1"];
  O [label="Log utilisasi perangkat keras", shape=note, fillcolor="white"];

  A->B->C->D->E->F->G;
  G->H; G->I; G->J;
  F->K [style=dashed, label="pad probe"];
  K->L;
  C->P [style=dashed, label="pad probe opsional"];
  P->Q;
  M->N->O;
}
